{
  "name": "ai-realty/autogen-builder",
  "description": "Autonomous AI-powered WordPress plugin for building complete real estate websites from natural language prompts",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "plugin",
    "real-estate",
    "ai",
    "claude",
    "mcp",
    "automation",
    "idx",
    "crm",
    "lead-generation"
  ],
  "authors": [
    {
      "name": "AI Realty Dev Team",
      "email": "dev@example.com"
    }
  ],
  "require": {
    "php": ">=8.0",
    "composer/installers": "~1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "wp-coding-standards/wpcs": "^2.3"
  },
  "autoload": {
    "classmap": [
      "includes/",
      "mcp/"
    ]
  },
  "support": {
    "issues": "https://github.com/yourusername/ai-realty-autogen-builder/issues",
    "source": "https://github.com/yourusername/ai-realty-autogen-builder"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
